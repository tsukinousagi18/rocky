// Check that binary ops and precedence dump correctly.
//
// Expressions are nested under their containing statements.

// RUN: %rocky --dump-ast -c "fn main() { 1 + 2; }" | FileCheck %s --check-prefix=ADD
// RUN: %rocky --dump-ast -c "fn main() { 1 + 2 * 3; }" | FileCheck %s --check-prefix=PRECEDENCE
// RUN: %rocky --dump-ast -c "fn main() { (1 + 2) * 3; }" | FileCheck %s --check-prefix=GROUPING

// ADD: function main()
// ADD-NEXT: └── block
// ADD-NEXT:     └── expression
// ADD-NEXT:         └── +
// ADD-NEXT:             ├── 1
// ADD-NEXT:             └── 2

// * binds tighter than +, so this is 1 + (2 * 3)
// PRECEDENCE: function main()
// PRECEDENCE-NEXT: └── block
// PRECEDENCE-NEXT:     └── expression
// PRECEDENCE-NEXT:         └── +
// PRECEDENCE-NEXT:             ├── 1
// PRECEDENCE-NEXT:             └── *
// PRECEDENCE-NEXT:                 ├── 2
// PRECEDENCE-NEXT:                 └── 3

// Parens force (1 + 2) first, then * 3
// GROUPING: function main()
// GROUPING-NEXT: └── block
// GROUPING-NEXT:     └── expression
// GROUPING-NEXT:         └── *
// GROUPING-NEXT:             ├── +
// GROUPING-NEXT:             │   ├── 1
// GROUPING-NEXT:             │   └── 2
// GROUPING-NEXT:             └── 3
