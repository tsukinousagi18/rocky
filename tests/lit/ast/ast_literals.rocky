// Run rocky with --dump-ast and check the printed AST.
// %rocky is replaced with the path to rocky.exe by lit.
// FileCheck compares the real output to the lines below.

// RUN: %rocky --dump-ast -c "fn main() { 42; }" | FileCheck %s --check-prefix=INT
// RUN: %rocky --dump-ast -c "fn main() { 3.14; }" | FileCheck %s --check-prefix=FLOAT
// RUN: %rocky --dump-ast -c "fn main() { true; }" | FileCheck %s --check-prefix=TRUE
// RUN: %rocky --dump-ast -c "fn main() { false; }" | FileCheck %s --check-prefix=FALSE

// INT: function main()
// INT:         └── 42
// FLOAT: function main()
// FLOAT:         └── 3.140000
// TRUE: function main()
// TRUE:         └── true
// FALSE: function main()
// FALSE:         └── false
